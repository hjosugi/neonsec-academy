{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neonsec-academy/lab-pack.schema.json",
  "title": "NeonSec Lab Pack",
  "description": "Manifest, challenge files, assets, and safety audit summary for a local lab pack (P5-010). Lab entries follow the Lab schema in src/data/labs.ts and are validated and re-audited by src/lib/labPacks.ts on import.",
  "type": "object",
  "required": ["format", "formatVersion", "id", "name", "version", "minAppVersion", "author", "license", "description", "labs", "safetyAudit"],
  "properties": {
    "format": { "const": "neonsec-lab-pack" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,48}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "minAppVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "license": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "labs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "kind", "difficulty", "brief", "scope", "evidenceTitle", "evidence", "flagChallenge", "objectives", "rubric", "guiding", "modelFindings", "safetyAudit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["local", "dataset", "simulated", "writeup"] },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "safetyAudit": {
            "type": "object",
            "required": ["rulesetVersion", "status", "reviewedAt"],
            "properties": {
              "rulesetVersion": { "type": "integer" },
              "status": { "const": "pass", "description": "Overrides are not accepted from packs." },
              "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    },
    "safetyAudit": {
      "type": "object",
      "required": ["rulesetVersion", "auditedAt", "results"],
      "properties": {
        "rulesetVersion": { "type": "integer" },
        "auditedAt": { "type": "string" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["labId", "status", "blockers", "warnings"],
            "properties": {
              "labId": { "type": "string" },
              "status": { "enum": ["pass", "fail"] },
              "blockers": { "type": "integer", "minimum": 0 },
              "warnings": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
