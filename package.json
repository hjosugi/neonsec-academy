{
  "name": "neonsec-academy",
  "private": true,
  "version": "1.0.38",
  "type": "module",
  "description": "NeonSec Academy — a cyberpunk CEH exam-prep platform: question bank, spaced-repetition review, mock exams, weakness analytics, and safe practical labs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate_questions.mjs",
    "validate:safety": "node scripts/safety_scan.mjs",
    "test": "vitest run",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update",
    "audit:labs": "node scripts/lab_safety_audit.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vitest/mocker@>=4.0.0 <4.1.12": "4.1.12",
    "nanoid@>=3.0.0 <3.3.18": "3.3.20",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
  }
}
